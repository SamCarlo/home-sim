[
  {"waitReady": true},
  {"assert": "window.__homesim.getState().phase === 'plan' && window.__homesim.getState().choice === null"},
  {"eval": "window.__pick = document.querySelector('.plan-cell.st-green'); window.__pick.dataset.loc + '|' + window.__pick.dataset.type"},
  {"eval": "window.__pick.click(); 'opened'"},
  {"waitFor": ".plan-detail-row .plan-dt-choose"},
  {"assert": "document.activeElement.classList.contains('plan-dt-title')"},
  {"assert": "(c => { const t = document.querySelectorAll('.plan-detail-row .plan-dt-costs tfoot td'); return 'Upfront ' + t[0].textContent === c.querySelector('.plan-cell-up').textContent && t[1].textContent + '/mo' === c.querySelector('.plan-cell-mo').textContent; })(window.__pick)"},
  {"assert": "!document.querySelector('.plan-detail-row .plan-dt-choose').disabled && document.querySelectorAll('.plan-detail-row .plan-dt-metric').length === 10 && document.querySelectorAll('.plan-detail-row .plan-dt-metric svg').length === 10"},
  {"click": ".plan-detail-row .plan-dt-choose"},
  {"waitFor": ".modal-confirm-dialog"},
  {"assert": "document.activeElement.classList.contains('modal-cancel') && document.querySelector('.modal-message').textContent.startsWith(\"You're choosing\")"},
  {"shot": "tools/shots/t15-confirm.png"},
  {"press": "Escape"},
  {"assert": "!document.querySelector('.modal-backdrop') && document.activeElement.classList.contains('plan-dt-choose') && window.__homesim.getState().phase === 'plan'"},
  {"click": ".plan-detail-row .plan-dt-choose"},
  {"waitFor": ".modal-confirm"},
  {"click": ".modal-confirm"},
  {"wait": 500},
  {"assert": "window.__homesim.getState().phase === 'paperwork'"},
  {"assert": "(s => s.choice && s.choice.locationId === window.__pick.dataset.loc && s.choice.homeTypeId === window.__pick.dataset.type && s.choice.snapshot.upfrontCents > 0 && s.choice.snapshot.breakdown.monthly.length > 0 && s.choice.chosenAt > 0 && s.plan.expanded === null && s.paperwork.committed === false)(window.__homesim.getState())"},
  {"waitReady": true},
  {"assert": "!document.querySelector('.modal-backdrop')"}
]
