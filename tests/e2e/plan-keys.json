[
  { "waitReady": true },
  { "assert": "window.__homesim.getState().phase === 'plan' && document.querySelectorAll('.plan-cell').length === 100" },
  { "assert": "document.querySelectorAll('.plan-cell[tabindex=\"0\"]').length === 1" },
  { "eval": "document.querySelector('.plan-cell[tabindex=\"0\"]').focus(); document.activeElement.getAttribute('aria-label')" },
  { "press": "ArrowRight" },
  { "assert": "document.activeElement.dataset.r === '0' && document.activeElement.dataset.c === '1'" },
  { "press": "ArrowDown" },
  { "assert": "document.activeElement.dataset.r === '1' && document.activeElement.dataset.c === '1'" },
  { "eval": "document.activeElement.getAttribute('aria-label')" },
  { "press": "Enter" },
  { "waitFor": ".plan-detail-row" },
  { "assert": "document.querySelector('.plan-detail-row').textContent.includes('Details coming in task 15')" },
  { "assert": "(e => e && e.homeTypeId === document.activeElement.dataset.type && e.locationId === document.activeElement.dataset.loc)(window.__homesim.getState().plan.expanded)" },
  { "assert": "document.activeElement.getAttribute('aria-expanded') === 'true' && document.querySelector('.plan-detail-row').previousElementSibling.contains(document.activeElement)" },
  { "shot": "tools/shots/t12-keys-open.png" },
  { "press": "End" },
  { "assert": "document.activeElement.dataset.c === '4'" },
  { "press": "Home" },
  { "assert": "document.activeElement.dataset.c === '0'" },
  { "press": "Escape" },
  { "assert": "!document.querySelector('.plan-detail-row') && window.__homesim.getState().plan.expanded === null" },
  { "assert": "document.activeElement.dataset.r === '1' && document.activeElement.dataset.c === '1'" },
  { "click": "#plan-hide" },
  { "assert": "window.__homesim.getState().plan.hideUnaffordable === true && document.querySelectorAll('.plan-cell.st-red:not([hidden])').length === 0" },
  { "assert": "document.querySelectorAll('.plan-cell:not([hidden])').length === document.querySelectorAll('.plan-cell:not(.st-red):not(.st-na)').length" }
]
