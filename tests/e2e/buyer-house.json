 { "assert": "(s => s.paperwork.steps['closing-disclosure'].status === 'done' && s.paperwork.options.closing.errorFlagged === true && s.paperwork.options.closing.wrongFlags === 1 && s.paperwork.options.closing.finalRate === s.paperwork.options.closing.agreedRate)(window.__homesim.getState())" }
