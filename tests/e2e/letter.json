  {"assert": "/^30 words/.test(document.querySelector('.pw-letter-count').textContent)"},
  {"wait": 600},
  {"shot": "tools/shots/t25/2-draft.png"},
  {"assert": "window.__homesim.getState().paperwork.steps['rental-cover'].status === 'draft'"},
  {"click": ".pw-letter-send"},
  {"waitFor": ".modal-confirm"},
  {"click": ".modal-confirm"},
  {"waitFor": ".pw-letter-sent"},
  {"assert": "window.__homesim.getState().paperwork.steps['rental-cover'].status === 'done'"},
  {"assert": "Object.values(window.__homesim.getState().letters).some((l) => l.type === 'rental-cover' && l.score.pending)"},
  {"assert": "document.querySelector('[data-step=\"rental-cover\"]').dataset.status === 'done'"},
  {"assert": "!document.querySelector('.pw-letter').textContent.includes('%')"},
  {"shot": "tools/shots/t25/3-sent.png"},
  {"click": ".header-portfolio"},
  {"waitFor": "[data-tab=letters]"},
  {"click": "[data-tab=letters]"},
  {"wait": 200},
  {"assert": "document.querySelector('#pf-panel').textContent.includes('Rental cover letter')"},
  {"eval": "Object.values(window.__homesim.getState().letters).map((l) => l.to)"}
